{
  "name": "@local/dsh-plugin-keyboard-flow",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Keyboard-first control for the DSH workspace: tree navigation, transcript scrolling, session stepping, focus cycling",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "shortcuts"
      ],
      "platform": "web"
    }
  }
}
